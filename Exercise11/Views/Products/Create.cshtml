
@model Product

<form asp-action="Create" method="post">
    <label>Name:</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label>Price:</label>
    <input asp-for="Price" />
    <span asp-validation-for="Price"></span>

    <label>Stock:</label>
    <input asp-for="Stock" />
    <span asp-validation-for="Stock"></span>

    <button type="submit">Create</button>
</form>